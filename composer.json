{
    "name": "james.xue/search",
    "description": "source search [资源搜索工具、包括给公众号发送消息和 github 提交代码、上传图片并使用cdn加速等]",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "search",
        "source",
        "source-search"
    ],
    "homepage": "https://github.com/xiaoxuan6/search.git",
    "autoload": {
        "psr-4": {
            "Vinhson\\Search\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "authors": [
        {
            "name": "xiaoxuan6",
            "email": "1527736751@qq.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-intl": "*",
        "guzzlehttp/guzzle": "^7.5 | ^7.8",
        "symfony/process": "*",
        "titasgailius/terminal": "^1.2",
        "pimple/pimple": "^3.5",
        "laravel/prompts": "dev-main",
        "illuminate/collections": "^10.48 | ^12.0",
        "illuminate/support": "^10.48 | ^12.0"
    },
    "scripts": {
        "pint": "vendor/bin/php-cs-fixer fix --config=vendor/james.xue/packet/.php-cs-fixer.php --using-cache=no --verbose --ansi",
        "rector": "vendor/bin/rector process --config=vendor/james.xue/packet/rector.php --no-diffs --ansi",
        "fix": [
            "@rector",
            "@pint"
        ],
        "unused": "vendor/bin/composer-unused --ansi -v"
    },
    "bin": [
        "bin/search"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "james.xue/packet": "^0.1 | ^1.0"
    }
}
